# Copy to .env (here or in any parent folder) and fill in. Never commit .env.
PORTKEY_API_KEY=
# Optional overrides
OPENAI_MODEL=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Backend
API_PORT=8000
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
# Optional: point the API at a different database file
# CC_DB_PATH=data/campus_customs.db
# Problem 9 (all optional)
# Smaller model for summarizing old chat (defaults to OPENAI_MODEL)
# SUMMARY_MODEL=
# Prices used to estimate cost per chat, USD per 1M tokens (defaults are placeholders)
MODEL_INPUT_PRICE_PER_MTOK=1.25
MODEL_OUTPUT_PRICE_PER_MTOK=10.00
# Staff accounts that can open /admin/usage (comma-separated)
ADMIN_EMAILS=test@campuscustoms.yale.edu
# Proxies allowed to set X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1
